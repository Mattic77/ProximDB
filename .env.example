# ==========================================
# ProximDB Environment Configuration Example
# Copy this file to .env and fill in your values
# DO NOT commit real secrets to source control
# ==========================================

# Port for Express server
PORT=3000

# Primary Database Connection URI (choose one for your setup)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# DATABASE_URL=mysql://user:password@localhost:3306/mydb
# DATABASE_URL=mongodb://localhost:27017/mydb

# Optional: Custom Embedded Storage Path (defaults to ./.proximdb/search.db)
# PROXIM_STORAGE_PATH=./.proximdb/search.db

# Optional: Background Sync Interval in milliseconds (e.g. 60000 for 1 min)
# PROXIM_SYNC_INTERVAL_MS=60000
